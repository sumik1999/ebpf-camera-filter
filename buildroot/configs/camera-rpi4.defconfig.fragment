# === Camera Packages - Video & Streaming ===
BR2_PACKAGE_GSTREAMER1=y
BR2_PACKAGE_GST1_PLUGINS_BASE=y
BR2_PACKAGE_GST1_PLUGINS_GOOD=y
BR2_PACKAGE_GST1_PLUGINS_BAD=y
BR2_PACKAGE_GST1_PLUGINS_BAD_Y4M=y
BR2_PACKAGE_GST1_PLUGINS_BAD_VIDEOFILTERS_BASICS=y
BR2_PACKAGE_GST1_PLUGINSUGLY=y
BR2_PACKAGE_MPLAYER=y
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_FFSERVER=n
BR2_PACKAGE_FFMPEG_AUTODETECT=n
BR2_PACKAGE_LIBJPEG=y
BR2_PACKAGE_LIBPNG=y
BR2_PACKAGE_LIBTIFF=y
BR2_PACKAGE_JPEGDEV=y
BR2_PACKAGE_MJPEGTOOLS=y
BR2_PACKAGE_LIBV4L=y
BR2_PACKAGE_V4L2UTILS=y

# === Web Server for Camera Web Interface ===
BR2_PACKAGE_LIGHTTPD=y
BR2_PACKAGE_LIGHTTPD_AUTH=y
BR2_PACKAGE_LIGHTTPD_OPENSSL=y
BR2_PACKAGE_LIGHTTPD_WEBDAV=y

# === MJPG Streamer for Camera Streaming ===
BR2_PACKAGE_MJPG_STREAMER=y
BR2_PACKAGE_MJPG_STREAMER_EXTRAS=y

# === Networking Tools ===
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_OPENSSH_CLIENT=y
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_CURL=y
BR2_PACKAGE_WGET=y
BR2_PACKAGE_NETCAT=y
BR2_PACKAGE_IPERF3=y

# === Security / Firewall ===
BR2_PACKAGE_NFTABLES=y
BR2_PACKAGE_IPTABLES=y
BR2_PACKAGE_BASH=y
BR2_PACKAGE_COREUTILS=y
BR2_PACKAGE_DOCKER=y
BR2_PACKAGE_DOCKER_COMPOSE=y

# === Debugging / Utilities ===
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_SYSSTAT=y
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_NET_TOOLS=y
BR2_PACKAGE_IFPLUGD=y
BR2_PACKAGE_IPUTILS=y
BR2_PACKAGE_STRACE=y
BR2_PACKAGE_LTRACE=y
BR2_PACKAGE_LVM2=y
BR2_PACKAGE_SQUASHFS=y
BR2_PACKAGE_SQUASHFSTOOLS=y

# === GPIO / Camera Hardware ===
BR2_PACKAGE_LIBGPIOD=y
BR2_PACKAGE_GPIOTOOLS=y
BR2_PACKAGE_RPI_TOOLS=y
BR2_PACKAGE_RPI_USERLAND=y

# === Time & Logging ===
BR2_PACKAGE_NTP=y
BR2_PACKAGE_LOGROTATE=y
BR2_PACKAGE_SYSLOG_NG=y

# === Filesystem ===
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="2048M"
BR2_TARGET_ROOTFS_EXT2_LABEL="rpi-camera-rootfs"

# === Kernel: Enable V4L2 and Camera Support ===
BR2_LINUX_KERNEL_DEFCONFIG="bcm2711"
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2711-rpi-4-b"
