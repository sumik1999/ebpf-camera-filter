# ============================================================
# Airport eBPF Defense – macOS (Lima/OrbStack Linux VM) config
# Public, non-secret defaults derived from the original WSL2 configuration from the original project.
#
# Run inside a Lima or OrbStack Linux guest, NOT on the macOS host.
# The Linux VM must have: clang, llvm, iproute2, bpftool, python3,
#   nftables, bridge-utils, linux-headers.
#
# XDP mode is now the PRIMARY filter (not optional as in the WSL2 build).
# TC ingress is kept as the fallback for virtual interfaces that do not
# support native XDP.
# ============================================================

# --- Experiment timing & rates ---
: "${NUM_CAMERAS:=4}"
: "${TEST_DURATION_SEC:=30}"
: "${TELEMETRY_INTERVAL_MS:=50}"
: "${TELEMETRY_PORT:=5001}"
: "${CAMERA_SERVICE_PORT:=8080}"
: "${UDP_ATTACK_PORT:=9000}"
: "${SYN_ATTACK_PORT:=8080}"
: "${UDP_ATTACK_PPS:=2000}"
: "${SYN_ATTACK_PPS:=1500}"
: "${MAX_ATTACK_PPS:=8000}"
: "${SAFE_MODE:=1}"
: "${AUTO_STOP_CPU_PERCENT:=85}"

# --- Visual demo ---
: "${VISUAL_DEMO_DURATION_SEC:=10}"
: "${VISUAL_DEMO_ATTACK_PPS:=2000}"
: "${VISUAL_DEMO_TARGET_MODE:=single_camera}"
: "${VISUAL_DEMO_ATTACK_TYPE:=udp}"
: "${ATTACK_TARGET_MODE:=round_robin}"

# --- Defense selection ---
# ATTACH_MODE: "xdp" (preferred on real NICs) or "tc" (fallback for veth)
: "${ATTACH_MODE:=xdp}"
# XDP mode: "native" | "skb" (generic/skb-mode for virtual interfaces)
: "${XDP_MODE:=skb}"

# --- eBPF sketch parameters ---
: "${CMS_WIDTH:=1024}"
: "${CMS_DEPTH:=4}"
: "${HEAVY_TABLE_SIZE:=256}"
: "${LIGHT_SKETCH_SIZE:=1024}"
: "${HEAVY_FLOW_THRESHOLD_PPS:=400}"
# APOC receives a bounded nftables service allowance, never an eBPF bypass.
: "${APOC_TRUST_RATE_PPS:=200}"
: "${APOC_TRUST_BURST_PACKETS:=50}"

# --- macOS / Lima path overrides ---
# clang target: Lima VMs on Apple Silicon run aarch64; Intel Macs use x86_64.
# Auto-detect at runtime (see attach scripts), but can be forced here:
: "${BPF_TARGET_ARCH:=}"   # leave blank for auto-detect

# --- Namespace and bridge names ---
: "${NS_APOC:=ns_apoc}"
: "${NS_ATTACKER:=ns_attacker}"
: "${NS_GUARD:=ns_guard}"
: "${BR_TERMINAL:=br_terminal}"
: "${BR_CAMERA:=br_camera}"

# --- IP plan (unchanged from WSL2 version) ---
: "${APOC_IP:=10.10.0.2}"
: "${ATTACKER_IP:=10.10.0.3}"
: "${GUARD_TERMINAL_IP:=10.10.0.1}"
: "${GUARD_CAMERA_IP:=10.20.0.1}"
: "${CAMERA1_IP:=10.20.0.11}"
: "${CAMERA2_IP:=10.20.0.12}"
: "${CAMERA3_IP:=10.20.0.13}"
: "${CAMERA4_IP:=10.20.0.14}"
: "${TERMINAL_CIDR:=10.10.0.0/24}"
: "${CAMERA_CIDR:=10.20.0.0/24}"

# --- Interface names ---
: "${APOC_IF:=v_apoc}"
: "${ATTACKER_IF:=v_attacker}"
: "${GUARD_TERMINAL_IF:=v_guard_a}"
: "${GUARD_CAMERA_IF:=v_guard_b}"
: "${CAMERA_IF:=v_camera}"
