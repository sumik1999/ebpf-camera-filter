config BR2_PACKAGE_AIRPORT_EBPF
	bool "airport eBPF filters"
	depends on BR2_aarch64
	depends on BR2_PACKAGE_BPFTOOL
	help
	  XDP eBPF filters for the Airport security camera project.
	  Includes Count-Min Sketch (CMS) and ElasticSketch filters
	  for real-time packet rate limiting at the NIC driver level.

	  https://github.com/kiran/airport-ebpf-mac

if BR2_PACKAGE_AIRPORT_EBPF

config BR2_PACKAGE_AIRPORT_EBPF_CMS
	bool "enable Count-Min Sketch filter"
	default y

config BR2_PACKAGE_AIRPORT_EBPF_ELASTIC
	bool "enable ElasticSketch filter"
	default y

endif
